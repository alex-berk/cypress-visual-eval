{
  "name": "cypress-visual-eval",
  "version": "0.0.1",
  "description": "AI-powered visual regression evaluation for Cypress",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "licens": "MIT",
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js",
      "require": "./dist/commands.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-berk/cypress-visual-eval.git"
  },
  "keywords": [
    "cypress",
    "visual-testing",
    "regression-testing",
    "ai"
  ],
  "author": "Alex Berk <aleks.berkov@gmail.com>",
  "bugs": {
    "url": "https://github.com/alex-berk/cypress-visual-eval/issues"
  },
  "homepage": "https://github.com/alex-berk/cypress-visual-eval#readme",
  "license": "MIT",
  "peerDependencies": {
    "cypress": ">=12"
  },
  "peerDependenciesMeta": {
    "cypress": {
      "optional": false
    }
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "cypress": "^15.13.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
